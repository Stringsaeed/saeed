# Public. Set on the Vercel project for production, preview, and development.
NEXT_PUBLIC_SANITY_PROJECT_ID=zpcx9076
NEXT_PUBLIC_SANITY_DATASET=production

# Server only. Already stored on Vercel as a sensitive variable. Never commit a value.
SANITY_API_TOKEN=

# Same value as the Sanity webhook secret. Requests that fail the signature check do nothing.
SANITY_WEBHOOK_SECRET=
