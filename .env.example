# Copy to .env.local and do not commit that file.
# The site builds and runs with the defaults below. Set a value only to override.

# Sanity. Defaults live in src/sanity/env.ts. Content is public, so
# SANITY_API_TOKEN is optional. SANITY_WEBHOOK_SECRET is what
# POST /api/revalidate checks before refreshing posts and links.
NEXT_PUBLIC_SANITY_PROJECT_ID=zpcx9076
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_TOKEN=
SANITY_WEBHOOK_SECRET=

# Absolute URLs (sitemap, feeds, robots.txt, llms.txt, the ARD manifest,
# the MCP server card). Unset, those use https://thisissaeed.com.
# A domain or origin, with no path. Example: https://preview.example.com
# NEXT_PUBLIC_SITE_URL=

# PostHog. On Vercel the integration injects these; local dev stays off
# until the token is set. The names match that integration, spelling included.
# NEXT_PUBLIC_SAEED_EXPERIMENTATON_POSTHOG_PROJECT_TOKEN=
# NEXT_PUBLIC_SAEED_EXPERIMENTATON_POSTHOG_HOST=https://us.posthog.com
